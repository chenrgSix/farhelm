{
  "name": "farhelm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && npm --prefix apps/server ci && npm --prefix apps/web ci && npm --prefix tests/contracts ci && cargo build --manifest-path agent/Cargo.toml --locked",
    "dev": "bash scripts/dev.sh",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:tls:renew": "node scripts/dev-tls.mjs renew",
    "test:tls": "node --test tests/e2e/tls-renewal.test.mjs",
    "test:tls:browser": "node tests/e2e/tls-renewal-browser.mjs",
    "dev:agent:container": "bash scripts/dev-agent-container.sh",
    "test:e2e": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs --test tests/e2e/farhelm.test.ts",
    "check": "npm --prefix apps/server run typecheck && npm --prefix apps/server test && npm --prefix apps/web run typecheck && npm --prefix apps/web test && npm --prefix tests/contracts test && cargo test --manifest-path agent/Cargo.toml --locked",
    "build": "npm --prefix apps/server run build && npm --prefix apps/web run build && cargo build --manifest-path agent/Cargo.toml --locked --release",
    "test:browser": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs tests/e2e/browser-smoke.ts",
    "test:terminal": "node tests/e2e/terminal.mjs",
    "test:terminal:browser": "node tests/e2e/terminal-browser.mjs",
    "test:health:browser": "node tests/e2e/health-browser.mjs",
    "format": "prettier --write \"apps/**/*.{ts,vue,css,json}\" \"tests/**/*.{ts,mjs,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"apps/**/*.{ts,vue,css,json}\" \"tests/**/*.{ts,mjs,json}\" --ignore-path .gitignore",
    "test:startup": "bash tests/e2e/dev-smoke.sh",
    "package:source": "python3 scripts/package-source.py",
    "test:ssh:browser": "node tests/e2e/ssh-browser.mjs",
    "test:ssh:target": "node tests/e2e/ssh-target.mjs",
    "test:ssh:backup": "FLEET_TEST_BACKUP_SSH=1 node tests/e2e/ssh-target.mjs",
    "build:agent:installers": "bash scripts/build-agent-installers.sh",
    "test:agent:install": "node tests/e2e/agent-install.mjs",
    "test:agent:upgrade": "node tests/e2e/agent-upgrade.mjs",
    "test:agent:upgrade:groups": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs tests/e2e/agent-upgrade-groups.ts",
    "test:agent:network": "node tests/e2e/agent-network.mjs",
    "test:access:browser": "node --import ./apps/server/node_modules/tsx/dist/loader.mjs tests/e2e/access-management.ts",
    "test:ssh:install-agent": "FLEET_TEST_SSH_AGENT_INSTALL=1 node tests/e2e/ssh-target.mjs",
    "test:platform-entry": "FLEET_TEST_FRONTEND_PROXY=vite FLEET_TEST_SSH_AGENT_INSTALL=1 node tests/e2e/ssh-target.mjs && FLEET_TEST_FRONTEND_PROXY=nginx FLEET_TEST_SSH_AGENT_INSTALL=1 node tests/e2e/ssh-target.mjs",
    "test:acme": "node tests/e2e/acme.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.10"
  }
}
