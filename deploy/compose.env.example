# Copy to .env in this deploy directory. Use the domain/IP reached by your clients.
FARHELM_PUBLIC_HOST=192.168.1.10
FARHELM_WEB_PORT=8443
FARHELM_AGENT_PORT=8444
FARHELM_SSH_PORT=2222
FARHELM_BIND_ADDRESS=0.0.0.0
# Defaults: Agent + SSH, HTTPS, automatically managed private CA.
FLEET_DEVICE_ACCESS=agent-ssh
FLEET_WEB_PROTOCOL=https
FLEET_ADMIN_USER=admin
# Empty = random password saved in the persistent volume as bootstrap-admin.json.
FLEET_ADMIN_PASSWORD=
# Use http for LAN web management; Agent HTTPS/CA still renew automatically.
# For certificate-free SSH devices with web management, use ssh-only and http.
# These are first-boot defaults; later changes belong in System Settings.

# Optional, read-only EasyTier observation (see docs/network-routes.md).
# CLI path is inside the selected EasyTier container when CONTAINER is set.
# The default server image does not bundle Docker/EasyTier/iproute2 tools.
FLEET_EASYTIER_CLI=easytier-cli
FLEET_EASYTIER_RPC=127.0.0.1:15888
FLEET_EASYTIER_CONTAINER=
