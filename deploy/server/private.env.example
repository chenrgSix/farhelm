# Pure LAN/offline, single HTTPS entry serving the built web app, API and Agent.
# Run node scripts/init-private-tls.mjs /var/lib/farhelm before the first start.
FLEET_HOST=0.0.0.0
FLEET_PORT=8443
FLEET_DATA_DIR=/var/lib/farhelm
FLEET_WEB_DIST=/opt/farhelm/apps/web/dist
FLEET_AGENT_DIST_DIR=/var/lib/farhelm/agent-dist
FLEET_TLS_CERT=/var/lib/farhelm/bootstrap-tls/server.crt
FLEET_TLS_KEY=/var/lib/farhelm/bootstrap-tls/server.key
FLEET_ACME_ENABLED=0
FLEET_ADMIN_USER=admin
FLEET_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
# Leave FLEET_CA_CERT / FLEET_AGENT_CA_CERT unset: installers take the active CA automatically.
# Set the private mode, hostname/IP and platform URL in system settings.
# Only if using an existing same-host TCP proxy, bind FLEET_HOST to 127.0.0.1 instead.
