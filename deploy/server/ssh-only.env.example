# Node >=24. Build apps/server; no web build, Agent or HTTPS certificate required.
FLEET_MODE=ssh-only
FLEET_DATA_DIR=/var/lib/farhelm
FLEET_SSH_HOST=0.0.0.0
FLEET_SSH_PORT=2222
# Initial administrator for a fresh database; remove after bootstrap.
FLEET_ADMIN_USER=admin
FLEET_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
# Local management: /var/lib/farhelm/admin.sock (0600), no HTTP TCP listener.
# Do not configure FLEET_TLS_CERT, FLEET_TLS_KEY, FLEET_CA_CERT or ACME.
