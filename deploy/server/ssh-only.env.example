# Node >=24. Build apps/server and apps/web. No HTTPS certificate or Agent required.
FLEET_DEVICE_ACCESS=ssh-only
FLEET_WEB_ENABLED=1
FLEET_WEB_PROTOCOL=http
FLEET_WEB_DIST=/opt/farhelm/apps/web/dist
FLEET_HOST=127.0.0.1
FLEET_PORT=8080
FLEET_DATA_DIR=/var/lib/farhelm
FLEET_SSH_HOST=0.0.0.0
FLEET_SSH_PORT=2222
# Bootstrap only: existing users/passwords are preserved.
FLEET_ADMIN_USER=admin
FLEET_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
# For trusted LAN access, explicitly change FLEET_HOST. HTTP traffic is not encrypted.
# No FLEET_TLS_CERT, FLEET_TLS_KEY, FLEET_CA_CERT or ACME configuration needed.
