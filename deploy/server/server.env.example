# Node >=24; build apps/server and apps/web before starting.
# Manual setup behind an existing TCP proxy; optional examples live in deploy/examples/nginx.
# New installations should use install.sh or deploy/compose.yml (no proxy required).
# Select HTTP-01 (80) or TLS-ALPN-01 (443, no 80 needed) in system settings.
FLEET_HOST=127.0.0.1
FLEET_PORT=8443
FLEET_DATA_DIR=/var/lib/farhelm
FLEET_WEB_DIST=/opt/farhelm/apps/web/dist
FLEET_AGENT_DIST_DIR=/var/lib/farhelm/agent-dist
# Initial trusted management certificate, e.g. localhost via an SSH tunnel.
# Once issued, the active ACME certificate is loaded from FLEET_DATA_DIR.
FLEET_TLS_CERT=/var/lib/farhelm/bootstrap-tls/server.crt
FLEET_TLS_KEY=/var/lib/farhelm/bootstrap-tls/server.key
FLEET_ACME_ENABLED=1
# Only used for HTTP-01; TLS-ALPN-01 shares FLEET_PORT and does not bind this port.
FLEET_ACME_HTTP_HOST=127.0.0.1
FLEET_ACME_HTTP_PORT=8080
# Set the initial admin credentials before first start; remove after bootstrap.
FLEET_ADMIN_USER=admin
FLEET_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
# Public ACME certificates require the Agent's built-in public roots.
# Leave FLEET_CA_CERT and FLEET_AGENT_CA_CERT unset.
# Configure the domain and platform address in the administrator UI.
