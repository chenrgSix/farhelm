{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/disk-usage.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "total_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "used_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "available_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "filesystem_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    }
  },
  "required": [
    "total_bytes",
    "used_bytes",
    "available_bytes",
    "filesystem_count"
  ]
}
