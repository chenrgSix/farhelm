{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/device-disk-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "interval_hours": {
      "enum": [1, 2, 8, 12, 24]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "disk-usage.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "checked_at": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "next_collection_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cache_until": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "collecting": {
      "type": "boolean"
    },
    "stale": {
      "type": "boolean"
    }
  },
  "required": [
    "v",
    "device_id",
    "interval_hours",
    "revision",
    "usage",
    "checked_at",
    "last_error",
    "next_collection_at",
    "cache_until",
    "collecting",
    "stale"
  ]
}
