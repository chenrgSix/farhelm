{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/deployment-response.schema.json",
  "title": "Farhelm v1 deployment-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "settings": {
      "$ref": "deployment-settings.schema.json"
    },
    "state": {
      "enum": ["idle", "applying", "awaiting_confirmation", "rolled_back"]
    },
    "entry_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "rollback_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "confirm_by": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "last_error": {
      "anyOf": [
        {
          "enum": ["APPLY_FAILED", "APPLY_INTERRUPTED", "CONFIRMATION_TIMEOUT"]
        },
        {
          "type": "null"
        }
      ]
    },
    "active_terminals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "https_ready": {
      "type": "boolean"
    },
    "recovery_command": {
      "type": "string",
      "maxLength": 4096
    }
  },
  "required": [
    "v",
    "revision",
    "settings",
    "state",
    "entry_url",
    "rollback_url",
    "confirm_by",
    "last_error",
    "active_terminals",
    "https_ready",
    "recovery_command"
  ]
}
