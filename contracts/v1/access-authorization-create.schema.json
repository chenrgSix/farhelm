{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/access-authorization-create.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "account_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      }
    },
    "subject_type": {
      "enum": ["user", "group", "role", "device_scope"]
    },
    "subject_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["v", "device_id", "account_ids", "subject_type", "subject_id"],
  "allOf": [
    {
      "if": {
        "properties": {
          "subject_type": {
            "const": "device_scope"
          }
        }
      },
      "then": {
        "properties": {
          "subject_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "subject_id": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      }
    }
  ]
}
