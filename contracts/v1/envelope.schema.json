{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/envelope.schema.json",
  "title": "Farhelm v1 envelope",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.hello"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "capabilities": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "maxLength": 64
              }
            },
            "server_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://[^\\s/@?#]+/?$"
            },
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "arch": {
                  "enum": ["aarch64", "x86_64"]
                },
                "sha256": {
                  "$ref": "common.schema.json#/$defs/sha256"
                }
              },
              "required": ["arch", "sha256"]
            },
            "trusted_ca_fingerprints": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?:[0-9A-F]{2}:){31}[0-9A-F]{2}$"
              }
            }
          },
          "required": ["agent_version"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.heartbeat"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "capabilities": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "string",
                "maxLength": 64
              }
            },
            "server_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://[^\\s/@?#]+/?$"
            }
          },
          "required": ["agent_version"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "task.assign"
        },
        "body": {
          "$ref": "task.schema.json"
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "task.cancel"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": ["task_id"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "task.event"
        },
        "body": {
          "$ref": "event.schema.json"
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "event.ack"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "task_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "seq": {
              "$ref": "common.schema.json#/$defs/sequence"
            }
          },
          "required": ["event_id", "task_id", "seq"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "error"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": ["code"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.reauth"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "access_token": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          "required": ["access_token"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "$ref": "terminal-envelope.schema.json"
    },
    {
      "$ref": "health-envelope.schema.json"
    },
    {
      "$ref": "agent-address-envelope.schema.json"
    },
    {
      "$ref": "agent-upgrade-envelope.schema.json"
    },
    {
      "$ref": "agent-network-envelope.schema.json"
    },
    {
      "$ref": "network-probe-envelope.schema.json"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.trust.update"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^(?:[0-9A-F]{2}:){31}[0-9A-F]{2}$"
            },
            "ca_pem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16384
            },
            "proof_pem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            "server_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            }
          },
          "required": [
            "request_id",
            "revision",
            "fingerprint",
            "ca_pem",
            "proof_pem",
            "server_name"
          ]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.trust.result"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^(?:[0-9A-F]{2}:){31}[0-9A-F]{2}$"
            },
            "status": {
              "enum": ["applied", "failed"]
            },
            "reason": {
              "anyOf": [
                {
                  "enum": [
                    "CERTIFICATE_INVALID",
                    "PERSIST_FAILED",
                    "CONFIG_FAILED"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "request_id",
            "revision",
            "fingerprint",
            "status",
            "reason"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "applied"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "reason": {
                    "enum": [
                      "CERTIFICATE_INVALID",
                      "PERSIST_FAILED",
                      "CONFIG_FAILED"
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "$ref": "agent-terminal-envelope.schema.json"
    },
    {
      "$ref": "agent-disk-envelope.schema.json"
    },
    {
      "$ref": "tcp-forward-envelope.schema.json"
    }
  ],
  "description": "Enumerated v1 WSS frames; 65536-byte UTF-8 limit before parsing. Only single-use terminal.attach tickets and in-place agent.reauth credentials appear in authenticated flows; never place tokens in URLs or logs."
}
