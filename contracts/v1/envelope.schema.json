{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/envelope.schema.json",
  "title": "Fleet v1 envelope",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.hello"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "capabilities": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "maxLength": 64
              }
            }
          },
          "required": ["agent_version"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.heartbeat"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "capabilities": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "maxLength": 64
              }
            }
          },
          "required": ["agent_version"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "task.assign"
        },
        "body": {
          "$ref": "task.schema.json"
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "task.cancel"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_id": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": ["task_id"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "task.event"
        },
        "body": {
          "$ref": "event.schema.json"
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "event.ack"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "task_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "seq": {
              "$ref": "common.schema.json#/$defs/sequence"
            }
          },
          "required": ["event_id", "task_id", "seq"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "error"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": ["code"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.reauth"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "access_token": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          "required": ["access_token"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "$ref": "terminal-envelope.schema.json"
    },
    {
      "$ref": "health-envelope.schema.json"
    }
  ],
  "description": "Enumerated v1 WSS frames; 65536-byte UTF-8 limit before parsing. Only single-use terminal.attach tickets and in-place agent.reauth credentials appear in authenticated flows; never place tokens in URLs or logs."
}
