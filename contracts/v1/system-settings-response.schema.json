{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/system-settings-response.schema.json",
  "title": "Farhelm v1 system-settings-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "platform_server_url": {
      "type": "string",
      "maxLength": 2048
    },
    "updated_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_https_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  },
  "required": [
    "v",
    "revision",
    "platform_server_url",
    "updated_at"
  ]
}
