{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/network-route-update.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "vpn_ip": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 45
    },
    "ssh_port": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 65535
    }
  },
  "required": ["v", "revision", "vpn_ip", "ssh_port"]
}
