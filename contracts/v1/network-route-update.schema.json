{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/network-route-update.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "network-policy.schema.json"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["v", "revision", "policy"]
}
