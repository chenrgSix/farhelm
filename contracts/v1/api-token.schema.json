{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/api-token.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "owner_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "owner_username": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "devices.read",
          "terminal.connect",
          "tasks.read",
          "tasks.read_all",
          "tasks.execute",
          "recordings.read",
          "recordings.read_all",
          "audit.read",
          "audit.read_all",
          "health.manage",
          "network.manage"
        ]
      },
      "uniqueItems": true,
      "maxItems": 11,
      "minItems": 1
    },
    "device_scope": {
      "anyOf": [
        {
          "const": "*"
        },
        {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      ]
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "prefix": {
      "type": "string",
      "pattern": "^fh_api_[A-Za-z0-9_-]{8}$"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "revoked_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_used_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_used_address": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    },
    "status": {
      "enum": ["active", "revoked", "expired", "owner_disabled"]
    }
  },
  "required": [
    "id",
    "owner_id",
    "owner_username",
    "name",
    "permissions",
    "device_scope",
    "expires_at",
    "prefix",
    "created_at",
    "updated_at",
    "revoked_at",
    "last_used_at",
    "last_used_address",
    "revision",
    "status"
  ]
}
