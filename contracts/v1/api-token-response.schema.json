{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/api-token-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "token": {
      "$ref": "api-token.schema.json"
    },
    "secret": {
      "type": "string",
      "pattern": "^fh_api_[A-Za-z0-9_-]{43}$"
    }
  },
  "required": ["v", "token"]
}
