{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/device.schema.json",
  "title": "Farhelm v1 device",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "control_online": {
      "type": "boolean"
    },
    "private_data_reachable": {
      "type": ["boolean", "null"]
    },
    "business_healthy": {
      "type": ["boolean", "null"]
    },
    "last_seen": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "connection_kind": {
      "enum": ["agent", "ssh"]
    },
    "terminal_available": {
      "type": "boolean"
    },
    "ssh_status": {
      "enum": ["unknown", "connected", "failed"]
    },
    "ssh_checked_at": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "ip_addresses": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 45
      }
    },
    "device_groups": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": ["id", "name"]
      }
    },
    "ssh_configured": {
      "type": "boolean"
    },
    "terminal_backend": {
      "enum": ["agent", "ssh", null]
    },
    "network_route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policy": {
          "anyOf": [
            {
              "$ref": "network-policy.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_supported": {
          "type": ["boolean", "null"]
        },
        "agent_applied": {
          "type": "boolean"
        },
        "ssh_active": {
          "type": "boolean"
        },
        "agent": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "channel": {
                  "enum": ["vpn", "public", "configured"]
                },
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "reason": {
                  "enum": [null, "VPN_UNREACHABLE", "VPN_RECOVERY_WAITING_IDLE"]
                },
                "checked_at": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "easytier": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "enum": ["p2p", "relay", "not_detected", "unknown"]
                    },
                    "latency_ms": {
                      "type": ["number", "null"],
                      "minimum": 0,
                      "maximum": 3600000
                    }
                  },
                  "required": ["state", "latency_ms"]
                },
                "connected": {
                  "type": "boolean"
                }
              },
              "required": [
                "channel",
                "endpoint",
                "reason",
                "checked_at",
                "easytier"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "ssh": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "channel": {
                  "enum": ["vpn", "public", "configured"]
                },
                "endpoint": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                "reason": {
                  "enum": [null, "VPN_UNREACHABLE", "VPN_RECOVERY_WAITING_IDLE"]
                },
                "checked_at": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "easytier": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "enum": ["p2p", "relay", "not_detected", "unknown"]
                    },
                    "latency_ms": {
                      "type": ["number", "null"],
                      "minimum": 0,
                      "maximum": 3600000
                    }
                  },
                  "required": ["state", "latency_ms"]
                },
                "connected": {
                  "type": "boolean"
                }
              },
              "required": [
                "channel",
                "endpoint",
                "reason",
                "checked_at",
                "easytier"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "revision",
        "policy",
        "agent_supported",
        "agent_applied",
        "ssh_active",
        "agent",
        "ssh"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "control_online",
    "private_data_reachable",
    "business_healthy",
    "last_seen",
    "revoked_at",
    "agent_version"
  ],
  "description": "Network routes report authenticated current Agent transport and last SSH observations. Unmeasured or stale evidence remains unknown.",
  "allOf": [
    {
      "if": {
        "properties": {
          "control_online": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "business_healthy": {
            "type": "null"
          }
        }
      }
    }
  ]
}
