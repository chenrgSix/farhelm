{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/device.schema.json",
  "title": "Farhelm v1 device",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "control_online": {
      "type": "boolean"
    },
    "private_data_reachable": {
      "type": "null"
    },
    "business_healthy": {
      "type": ["boolean", "null"]
    },
    "last_seen": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "revoked_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "agent_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "connection_kind": {
      "enum": ["agent", "ssh"]
    },
    "terminal_available": {
      "type": "boolean"
    },
    "ssh_status": {
      "enum": ["unknown", "connected", "failed"]
    },
    "ssh_checked_at": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "ip_addresses": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 45
      }
    }
  },
  "required": [
    "id",
    "name",
    "control_online",
    "private_data_reachable",
    "business_healthy",
    "last_seen",
    "revoked_at",
    "agent_version"
  ],
  "description": "Business health comes from fresh Agent-local configured probes; offline, unconfigured, unsupported and expired states remain null. Private-data reachability is unmeasured.",
  "allOf": [
    {
      "if": {
        "properties": {
          "control_online": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "business_healthy": {
            "type": "null"
          }
        }
      }
    }
  ]
}
