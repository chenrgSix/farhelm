{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/network-probe-envelope.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.network.probe.config"
        },
        "body": {
          "$ref": "network-probe-config.schema.json"
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.network.probe.configured"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["revision"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.network.probe.event"
        },
        "body": {
          "$ref": "network-probe-report.schema.json"
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.network.probe.latest"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "report": {
              "$ref": "network-probe-report.schema.json"
            },
            "age_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["report", "age_ms"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.network.probe.ack"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sample_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["sample_id", "seq"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.network.probe.rejected"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "code": {
              "const": "NETWORK_PROBE_CONFIG_REJECTED"
            }
          },
          "required": ["revision", "code"]
        }
      },
      "required": ["v", "type", "body"]
    }
  ]
}
