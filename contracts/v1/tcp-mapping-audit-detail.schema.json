{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/tcp-mapping-audit-detail.schema.json",
  "$defs": {
    "saved": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mapping_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "owner_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "enabled": {
          "type": "boolean"
        },
        "listen_host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 45
        },
        "listen_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "target_host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "target_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "source_cidrs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "required": [
        "mapping_id",
        "revision",
        "owner_id",
        "name",
        "enabled",
        "listen_host",
        "listen_port",
        "target_host",
        "target_port",
        "source_cidrs"
      ]
    },
    "deleted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mapping_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "mapping_id",
        "revision"
      ]
    },
    "denied": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mapping_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "source_address": {
          "type": "string",
          "minLength": 0,
          "maxLength": 45
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "mapping_id",
        "source_address",
        "reason"
      ]
    },
    "opened": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mapping_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "source_address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 45
        },
        "forward_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "backend": {
          "enum": [
            "agent",
            "ssh"
          ]
        }
      },
      "required": [
        "mapping_id",
        "source_address",
        "forward_id",
        "host",
        "port",
        "backend"
      ]
    },
    "closed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mapping_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "source_address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 45
        },
        "forward_id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "backend": {
          "enum": [
            "agent",
            "ssh"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "opened": {
          "type": "boolean"
        },
        "bytes_sent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bytes_received": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "mapping_id",
        "source_address",
        "forward_id",
        "host",
        "port",
        "backend",
        "reason",
        "opened",
        "bytes_sent",
        "bytes_received"
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "tcp-mapping-audit-detail.schema.json#/$defs/saved"
    },
    {
      "$ref": "tcp-mapping-audit-detail.schema.json#/$defs/deleted"
    },
    {
      "$ref": "tcp-mapping-audit-detail.schema.json#/$defs/denied"
    },
    {
      "$ref": "tcp-mapping-audit-detail.schema.json#/$defs/opened"
    },
    {
      "$ref": "tcp-mapping-audit-detail.schema.json#/$defs/closed"
    }
  ]
}
