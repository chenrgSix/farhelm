{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/agent-route-envelope.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.route.config"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "policy": {
              "anyOf": [
                {
                  "$ref": "network-policy.schema.json"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["revision", "policy"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.route.status"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "channel": {
              "enum": ["vpn", "public", "configured"]
            },
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "reason": {
              "enum": [null, "VPN_UNREACHABLE", "VPN_RECOVERY_WAITING_IDLE"]
            },
            "easytier": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "enum": ["p2p", "relay", "not_detected", "unknown"]
                },
                "latency_ms": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 3600000
                }
              },
              "required": ["state", "latency_ms"]
            }
          },
          "required": ["revision", "channel", "endpoint", "reason", "easytier"]
        }
      },
      "required": ["v", "type", "body"]
    }
  ]
}
