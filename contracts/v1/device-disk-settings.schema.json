{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/device-disk-settings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "interval_hours": {
      "enum": [1, 2, 8, 12, 24]
    }
  },
  "required": ["v", "revision", "interval_hours"]
}
