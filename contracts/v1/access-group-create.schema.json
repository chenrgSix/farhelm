{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/access-group-create.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 0,
      "maxLength": 500
    },
    "role_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 32
    },
    "member_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 1000
    },
    "device_scope": {
      "anyOf": [
        {
          "const": "*"
        },
        {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 1000
        }
      ]
    }
  },
  "required": [
    "v",
    "name",
    "description",
    "role_ids",
    "member_ids",
    "device_scope"
  ]
}
