{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/agent-install-response.schema.json",
  "title": "Farhelm v1 agent-install-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "server_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://[^\\s/@?#]+/?$"
    }
  },
  "required": [
    "v",
    "id",
    "command",
    "expires_at",
    "server_url"
  ]
}
