{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/agent-upgrade-request.schema.json",
  "title": "Farhelm v1 agent-upgrade-request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "request_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        },
        "required": ["device_id", "sha256"]
      }
    }
  },
  "required": ["v", "request_id", "concurrency", "targets"]
}
