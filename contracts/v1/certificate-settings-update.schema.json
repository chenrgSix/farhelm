{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/certificate-settings-update.schema.json",
  "title": "Farhelm v1 certificate-settings-update",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "domain": {
      "description": "Certificate hostname: public DNS name or globally routable IPv4/IPv6 in acme mode; private names/IPs also allowed in private mode. No URL, port or IPv6 brackets.",
      "type": "string",
      "maxLength": 253
    },
    "email": {
      "type": "string",
      "maxLength": 254
    },
    "enabled": {
      "type": "boolean"
    },
    "tos_agreed": {
      "type": "boolean"
    },
    "mode": {
      "enum": ["acme", "private"]
    },
    "challenge_type": {
      "enum": ["http-01", "tls-alpn-01"]
    },
    "additional_domains": {
      "description": "Additional DNS names or IP addresses on the same private-CA certificate. Omission preserves existing private-mode entries; an empty array removes them.",
      "type": "array",
      "maxItems": 31,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253
      }
    }
  },
  "required": ["v", "revision", "domain", "email", "enabled", "tos_agreed"],
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "private"
          }
        },
        "required": ["mode"]
      },
      "else": {
        "properties": {
          "additional_domains": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
