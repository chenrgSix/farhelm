{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/certificate-settings-update.schema.json",
  "title": "Farhelm v1 certificate-settings-update",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "domain": {
      "type": "string",
      "maxLength": 253
    },
    "email": {
      "type": "string",
      "maxLength": 254
    },
    "enabled": {
      "type": "boolean"
    },
    "tos_agreed": {
      "type": "boolean"
    }
  },
  "required": ["v", "revision", "domain", "email", "enabled", "tos_agreed"]
}
