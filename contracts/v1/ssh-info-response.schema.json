{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/ssh-info-response.schema.json",
  "title": "Farhelm SSH connection information",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "enabled": {
      "type": "boolean"
    },
    "host": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9.:\\[\\]-]+$"
    },
    "port": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 65535
    },
    "fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$"
    }
  },
  "required": [
    "v",
    "enabled",
    "host",
    "port",
    "fingerprint"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "port": {
            "type": "integer"
          },
          "fingerprint": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "host": {
            "type": "null"
          },
          "port": {
            "type": "null"
          },
          "fingerprint": {
            "type": "null"
          }
        }
      }
    }
  ]
}
