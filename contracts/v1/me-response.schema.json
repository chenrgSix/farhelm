{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/me-response.schema.json",
  "title": "Farhelm v1 me-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "role": {
      "enum": ["admin", "ops", "business", "auditor"]
    },
    "device_scope": {
      "anyOf": [
        {
          "const": "*"
        },
        {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "devices.read",
          "terminal.connect",
          "tasks.read",
          "tasks.read_all",
          "tasks.execute",
          "recordings.read",
          "recordings.read_all",
          "audit.read",
          "audit.read_all",
          "health.manage",
          "network.manage"
        ]
      },
      "uniqueItems": true,
      "maxItems": 11
    },
    "role_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "role_names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "group_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "device_access": {
          "enum": ["agent-ssh", "ssh-only"]
        },
        "web_enabled": {
          "type": "boolean"
        },
        "web_protocol": {
          "enum": ["http", "https"]
        }
      },
      "required": ["device_access", "web_enabled", "web_protocol"]
    },
    "must_change_password": {
      "type": "boolean"
    }
  },
  "required": ["v", "id", "username", "role", "device_scope"]
}
