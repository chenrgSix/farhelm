{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/terminal-privilege-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "enabled": {
      "type": ["boolean", "null"]
    },
    "desired_enabled": {
      "type": ["boolean", "null"]
    },
    "online": {
      "type": "boolean"
    },
    "supported": {
      "type": ["boolean", "null"]
    },
    "blocked": {
      "type": "boolean"
    },
    "status": {
      "enum": ["unknown", "pending", "applied", "failed"]
    },
    "reason": {
      "enum": [
        null,
        "ACTIVE_TERMINALS",
        "NO_NEW_PRIVS",
        "PERSIST_FAILED",
        "STALE_REVISION",
        "REVISION_CONFLICT"
      ]
    }
  },
  "required": [
    "v",
    "device_id",
    "revision",
    "enabled",
    "desired_enabled",
    "online",
    "supported",
    "blocked",
    "status",
    "reason"
  ]
}
