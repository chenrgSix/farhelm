{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/audit.schema.json",
  "title": "Farhelm v1 audit",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "actor_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "device_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "enum": [
        "user.bootstrap",
        "user.login",
        "user.login_failed",
        "enrollment.created",
        "device.enrolled",
        "device.revoked",
        "task.created",
        "task.cancel_requested",
        "output.viewed",
        "authorization.denied",
        "task.accepted",
        "task.started",
        "task.finished",
        "terminal.created",
        "terminal.opened",
        "terminal.closed",
        "terminal.recording_viewed",
        "terminal.recording_exported",
        "health.configured",
        "health.run_requested",
        "connection.configured",
        "connection.host_key_scanned",
        "connection.tested",
        "settings.updated",
        "settings.agent_sync",
        "settings.sync_requested",
        "agent.upgrade_requested",
        "agent.upgrade_status",
        "agent.release_uploaded",
        "agent.release_imported",
        "agent.release_availability",
        "network.probes_configured",
        "access.user_created",
        "access.user_updated",
        "access.password_reset",
        "access.role_created",
        "access.role_updated",
        "access.role_deleted",
        "access.group_created",
        "access.group_updated",
        "access.group_deleted",
        "access.device_group_created",
        "access.device_group_updated",
        "access.device_group_deleted",
        "access.device_tags_updated",
        "device.agent_enabled"
      ]
    },
    "detail": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "role": {
              "enum": ["admin", "ops", "business", "auditor"]
            }
          },
          "required": ["username", "role"]
        },
        {
          "$ref": "common.schema.json#/$defs/empty"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username_hash": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": ["username_hash"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expires_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "name": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/name"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["expires_at", "name"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recovered": {
              "type": "boolean"
            }
          },
          "required": ["recovered"]
        },
        {
          "$ref": "common.schema.json#/$defs/empty"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "AGENT_EXEC"
            },
            "argv": {
              "$ref": "common.schema.json#/$defs/argv"
            },
            "cwd": {
              "$ref": "common.schema.json#/$defs/cwd"
            },
            "role": {
              "enum": ["admin", "ops", "business", "auditor"]
            },
            "authorized": {
              "const": true
            },
            "payload_hash": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "action",
            "argv",
            "cwd",
            "role",
            "authorized",
            "payload_hash"
          ]
        },
        {
          "$ref": "common.schema.json#/$defs/empty"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stream": {
              "enum": ["stdout", "stderr"]
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            }
          },
          "required": ["stream", "sha256", "size"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "route": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["reason", "method", "route"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "seq": {
              "$ref": "common.schema.json#/$defs/sequence"
            },
            "at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "payload": {
              "$ref": "common.schema.json#/$defs/empty"
            }
          },
          "required": ["event_id", "seq", "at", "payload"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "seq": {
              "$ref": "common.schema.json#/$defs/sequence"
            },
            "at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "payload": {
              "$ref": "common.schema.json#/$defs/empty"
            }
          },
          "required": ["event_id", "seq", "at", "payload"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "seq": {
              "$ref": "common.schema.json#/$defs/sequence"
            },
            "at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "payload": {
              "$ref": "result.schema.json"
            }
          },
          "required": ["event_id", "seq", "at", "payload"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "required": ["session_id"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "required": ["session_id"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "audit_complete": {
              "type": "boolean"
            }
          },
          "required": ["session_id", "reason", "audit_complete"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "after": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["session_id", "after"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "session_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "last_seq": {
              "$ref": "common.schema.json#/$defs/sequence"
            }
          },
          "required": ["session_id", "last_seq"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
