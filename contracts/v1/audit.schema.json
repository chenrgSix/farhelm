        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["revision"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            },
            "kind": {
              "enum": ["agent", "ssh"]
            }
          },
          "required": ["revision", "kind"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {},
          "required": []
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["revision"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "platform_server_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://[^\\s/@?#]+/?$"
            }
          },
          "required": ["revision", "platform_server_url"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "status": {
              "enum": ["saved", "applied", "failed"]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["revision", "status", "reason"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["revision"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "upgrade_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "batch_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "version": {
              "type": "string",
              "pattern": "^\\d{1,6}\\.\\d{1,6}\\.\\d{1,6}$"
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": ["upgrade_id", "batch_id", "version", "sha256"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "upgrade_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "status": {
              "enum": [
                "QUEUED",
                "DOWNLOADING",
                "WAITING_IDLE",
                "RESTARTING",
                "SUCCEEDED",
                "FAILED",
                "UNKNOWN"
              ]
            },
            "reason": {
              "enum": [
                null,
                "DOWNLOAD_FAILED",
                "PACKAGE_INVALID",
                "PERSIST_FAILED",
                "TRIAL_FAILED",
                "BUSY_EXPIRED",
                "REVOKED",
                "PACKAGE_MISSING",
                "RESULT_UNCONFIRMED"
              ]
            }
          },
          "required": ["upgrade_id", "status", "reason"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "arch": {
              "enum": ["aarch64", "x86_64"]
            },
            "version": {
              "type": "string",
              "pattern": "^\\d{1,6}\\.\\d{1,6}\\.\\d{1,6}$"
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 64,
              "maximum": 67108864
            }
          },
          "required": ["arch", "version", "sha256", "size"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "arch": {
              "enum": ["aarch64", "x86_64"]
            },
            "version": {
              "type": "string",
              "pattern": "^\\d{1,6}\\.\\d{1,6}\\.\\d{1,6}$"
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 64,
              "maximum": 67108864
            }
          },
          "required": ["arch", "version", "sha256", "size"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": ["sha256", "enabled"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "enabled": {
              "type": "boolean"
            },
            "target_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "interval_secs": {
              "type": "integer",
              "minimum": 5,
              "maximum": 3600
            }
          },
          "required": ["revision", "enabled", "target_count", "interval_secs"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "changes": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "username": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,63}$"
                },
                "enabled": {
                  "type": "boolean"
                },
                "role_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "uniqueItems": true,
                  "maxItems": 32
                },
                "group_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "uniqueItems": true,
                  "maxItems": 100
                },
                "device_scope": {
                  "anyOf": [
                    {
                      "const": "*"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "common.schema.json#/$defs/id"
                      },
                      "uniqueItems": true,
                      "maxItems": 1000
                    }
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 500
                },
                "permissions": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "devices.read",
                      "terminal.connect",
                      "tasks.read",
                      "tasks.execute",
                      "recordings.read",
                      "audit.read",
                      "health.manage",
                      "network.manage"
                    ]
                  },
                  "uniqueItems": true,
                  "maxItems": 8
                },
                "member_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "uniqueItems": true,
                  "maxItems": 1000
                },
                "device_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "uniqueItems": true,
                  "maxItems": 1000
                },
                "operation": {
                  "enum": ["add", "remove"]
                }
              },
              "required": []
            }
          },
          "required": ["target_id", "revision", "changes"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "installation_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "required": ["installation_id"]
        }
      ]
    }
  },
  "required": [
    "id",
    "at",
    "actor_id",
    "device_id",
    "task_id",
    "action",
    "detail"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "user.bootstrap"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "role": {
                "enum": ["admin", "ops", "business", "auditor"]
              }
            },
            "required": ["username", "role"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "user.login"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "$ref": "common.schema.json#/$defs/empty"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "user.login_failed"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "username_hash": {
                "$ref": "common.schema.json#/$defs/sha256"
              }
            },
            "required": ["username_hash"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "enrollment.created"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expires_at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
              "name": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/name"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["expires_at", "name"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "device.enrolled"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "recovered": {
                "type": "boolean"
              }
            },
            "required": ["recovered"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "device.revoked"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "$ref": "common.schema.json#/$defs/empty"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "task.created"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "AGENT_EXEC"
              },
              "argv": {
                "$ref": "common.schema.json#/$defs/argv"
              },
              "cwd": {
                "$ref": "common.schema.json#/$defs/cwd"
              },
              "role": {
                "enum": ["admin", "ops", "business", "auditor"]
              },
              "authorized": {
                "const": true
              },
              "payload_hash": {
                "$ref": "common.schema.json#/$defs/sha256"
              }
            },
            "required": [
              "action",
              "argv",
              "cwd",
              "role",
              "authorized",
              "payload_hash"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "task.cancel_requested"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "$ref": "common.schema.json#/$defs/empty"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "output.viewed"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stream": {
                "enum": ["stdout", "stderr"]
              },
              "sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              }
            },
            "required": ["stream", "sha256", "size"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "authorization.denied"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "route": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["reason", "method", "route"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "task.accepted"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "seq": {
                "$ref": "common.schema.json#/$defs/sequence"
              },
              "at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
