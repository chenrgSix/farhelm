{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/audit.schema.json",
  "title": "Fleet v1 audit",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "actor_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "device_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "enum": [
        "user.bootstrap",
        "user.login",
        "user.login_failed",
        "enrollment.created",
        "device.enrolled",
        "device.revoked",
        "task.created",
        "task.cancel_requested",
        "output.viewed",
        "authorization.denied",
        "task.accepted",
        "task.started",
        "task.finished"
      ]
    },
    "detail": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "role": {
              "enum": [
                "admin",
                "ops",
                "business",
                "auditor"
              ]
            }
          },
          "required": [
            "username",
            "role"
          ]
        },
        {
          "$ref": "common.schema.json#/$defs/empty"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username_hash": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "username_hash"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "expires_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "name": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/name"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "expires_at",
            "name"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recovered": {
              "type": "boolean"
            }
          },
          "required": [
            "recovered"
          ]
        },
        {
          "$ref": "common.schema.json#/$defs/empty"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "AGENT_EXEC"
            },
            "argv": {
              "$ref": "common.schema.json#/$defs/argv"
            },
            "cwd": {
              "$ref": "common.schema.json#/$defs/cwd"
            },
            "role": {
              "enum": [
                "admin",
                "ops",
                "business",
                "auditor"
              ]
            },
            "authorized": {
              "const": true
            },
            "payload_hash": {
              "$ref": "common.schema.json#/$defs/sha256"
            }
          },
          "required": [
            "action",
            "argv",
            "cwd",
            "role",
            "authorized",
            "payload_hash"
          ]
        },
        {
          "$ref": "common.schema.json#/$defs/empty"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stream": {
              "enum": [
                "stdout",
                "stderr"
              ]
            },
            "sha256": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1048576
            }
          },
          "required": [
            "stream",
            "sha256",
            "size"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "route": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reason",
            "method",
            "route"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "seq": {
              "$ref": "common.schema.json#/$defs/sequence"
            },
            "at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "payload": {
              "$ref": "common.schema.json#/$defs/empty"
            }
          },
          "required": [
            "event_id",
            "seq",
            "at",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "seq": {
              "$ref": "common.schema.json#/$defs/sequence"
            },
            "at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "payload": {
              "$ref": "common.schema.json#/$defs/empty"
            }
          },
          "required": [
            "event_id",
            "seq",
            "at",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "event_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "seq": {
              "$ref": "common.schema.json#/$defs/sequence"
            },
            "at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "payload": {
              "$ref": "result.schema.json"
            }
          },
          "required": [
            "event_id",
            "seq",
            "at",
            "payload"
          ]
        }
      ]
    }
  },
  "required": [
    "id",
    "at",
    "actor_id",
    "device_id",
    "task_id",
    "action",
    "detail"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "user.bootstrap"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "username": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "role": {
                "enum": [
                  "admin",
                  "ops",
                  "business",
                  "auditor"
                ]
              }
            },
            "required": [
              "username",
              "role"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "user.login"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "$ref": "common.schema.json#/$defs/empty"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "user.login_failed"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "username_hash": {
                "$ref": "common.schema.json#/$defs/sha256"
              }
            },
            "required": [
              "username_hash"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "enrollment.created"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expires_at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
              "name": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/name"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "expires_at",
              "name"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "device.enrolled"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "recovered": {
                "type": "boolean"
              }
            },
            "required": [
              "recovered"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "device.revoked"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "$ref": "common.schema.json#/$defs/empty"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "task.created"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "AGENT_EXEC"
              },
              "argv": {
                "$ref": "common.schema.json#/$defs/argv"
              },
              "cwd": {
                "$ref": "common.schema.json#/$defs/cwd"
              },
              "role": {
                "enum": [
                  "admin",
                  "ops",
                  "business",
                  "auditor"
                ]
              },
              "authorized": {
                "const": true
              },
              "payload_hash": {
                "$ref": "common.schema.json#/$defs/sha256"
              }
            },
            "required": [
              "action",
              "argv",
              "cwd",
              "role",
              "authorized",
              "payload_hash"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "task.cancel_requested"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "$ref": "common.schema.json#/$defs/empty"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "output.viewed"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "stream": {
                "enum": [
                  "stdout",
                  "stderr"
                ]
              },
              "sha256": {
                "$ref": "common.schema.json#/$defs/sha256"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              }
            },
            "required": [
              "stream",
              "sha256",
              "size"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "authorization.denied"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "route": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason",
              "method",
              "route"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "task.accepted"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "seq": {
                "$ref": "common.schema.json#/$defs/sequence"
              },
              "at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
              "payload": {
                "$ref": "common.schema.json#/$defs/empty"
              }
            },
            "required": [
              "event_id",
              "seq",
              "at",
              "payload"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "task.started"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "seq": {
                "$ref": "common.schema.json#/$defs/sequence"
              },
              "at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
              "payload": {
                "$ref": "common.schema.json#/$defs/empty"
              }
            },
            "required": [
              "event_id",
              "seq",
              "at",
              "payload"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "task.finished"
          }
        }
      },
      "then": {
        "properties": {
          "detail": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "$ref": "common.schema.json#/$defs/uuid"
              },
              "seq": {
                "$ref": "common.schema.json#/$defs/sequence"
              },
              "at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
              "payload": {
                "$ref": "result.schema.json"
              }
            },
            "required": [
              "event_id",
              "seq",
              "at",
              "payload"
            ]
          }
        }
      }
    }
  ],
  "description": "Strict current server audit output variants. New actions and detail fields require explicit contract updates; storage may remain extensible."
}
