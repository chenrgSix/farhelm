{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/agent-terminal-envelope.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.terminal.config"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "required": ["revision", "enabled"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "agent.terminal.status"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "enabled": {
              "type": "boolean"
            },
            "request_revision": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "blocked": {
              "type": "boolean"
            },
            "reason": {
              "enum": [
                null,
                "ACTIVE_TERMINALS",
                "NO_NEW_PRIVS",
                "PERSIST_FAILED",
                "STALE_REVISION",
                "REVISION_CONFLICT"
              ]
            }
          },
          "required": [
            "revision",
            "enabled",
            "request_revision",
            "blocked",
            "reason"
          ]
        }
      },
      "required": ["v", "type", "body"]
    }
  ]
}
