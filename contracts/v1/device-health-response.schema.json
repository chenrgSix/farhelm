{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/device-health-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "supported": {
      "type": "boolean"
    },
    "device_online": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "enabled": {
            "type": "boolean"
          },
          "interval_secs": {
            "type": "integer",
            "minimum": 5,
            "maximum": 3600
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 30000
          },
          "failure_threshold": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "probe": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "http"
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^https?://"
                  },
                  "expected_status": {
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 599
                  },
                  "body_contains": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 256
                  }
                },
                "required": [
                  "kind",
                  "url",
                  "expected_status",
                  "body_contains"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "tcp"
                  },
                  "host": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 253,
                    "pattern": "^[a-zA-Z0-9.:\\[\\]_-]+$"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "required": [
                  "kind",
                  "host",
                  "port"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "systemd"
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.@-]*\\.service$"
                  }
                },
                "required": [
                  "kind",
                  "unit"
                ]
              }
            ]
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "healthy",
                  "unhealthy",
                  "unknown",
                  "disabled"
                ]
              },
              "last_checked_at": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "duration_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 30000
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Z0-9_]+$"
              },
              "consecutive_failures": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              }
            },
            "required": [
              "status",
              "last_checked_at",
              "duration_ms",
              "reason",
              "consecutive_failures"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "enabled",
          "interval_secs",
          "timeout_ms",
          "failure_threshold",
          "probe",
          "result"
        ]
      }
    }
  },
  "required": [
    "v",
    "revision",
    "supported",
    "device_online",
    "checks"
  ]
}
