{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/platform-network-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "settings": {
      "$ref": "platform-network-settings.schema.json"
    },
    "agent_enabled": {
      "type": "boolean"
    },
    "platform_server_url": {
      "type": "string",
      "maxLength": 2048
    },
    "legacy_devices": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "suggested_agent": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vpn_url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "public_url": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048
                },
                {
                  "type": "null"
                }
              ]
            },
            "vpn_ip": {
              "type": "string",
              "minLength": 1,
              "maxLength": 45
            }
          },
          "required": ["vpn_url", "public_url"]
        },
        {
          "type": "null"
        }
      ]
    },
    "device_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "pending_agents": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "v",
    "revision",
    "updated_at",
    "settings",
    "agent_enabled",
    "platform_server_url",
    "legacy_devices",
    "suggested_agent",
    "device_count",
    "pending_agents"
  ]
}
