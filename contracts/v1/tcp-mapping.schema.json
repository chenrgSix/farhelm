{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/tcp-mapping.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "enabled": {
      "type": "boolean"
    },
    "listen_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 45
    },
    "listen_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "target_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "target_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "source_cidrs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "owner_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "enum": [
        "disabled",
        "listening",
        "error"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "connections": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16
    }
  },
  "required": [
    "name",
    "enabled",
    "listen_host",
    "listen_port",
    "target_host",
    "target_port",
    "source_cidrs",
    "id",
    "device_id",
    "owner_id",
    "revision",
    "created_at",
    "updated_at",
    "status",
    "error",
    "connections"
  ]
}
