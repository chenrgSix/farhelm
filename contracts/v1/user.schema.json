{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/user.schema.json",
  "title": "Farhelm v1 user",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "role": {
      "enum": ["admin", "ops", "business", "auditor"]
    },
    "device_scope": {
      "anyOf": [
        {
          "const": "*"
        },
        {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "devices.read",
          "terminal.connect",
          "terminal.sudo",
          "tasks.read",
          "tasks.read_all",
          "tasks.execute",
          "recordings.read",
          "recordings.read_all",
          "audit.read",
          "audit.read_all",
          "health.manage",
          "network.manage"
        ]
      },
      "uniqueItems": true,
      "maxItems": 12
    },
    "role_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "role_names": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "group_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "must_change_password": {
      "type": "boolean"
    },
    "api_token_id": {
      "$ref": "common.schema.json#/$defs/id"
    }
  },
  "required": ["id", "username", "role", "device_scope"]
}
