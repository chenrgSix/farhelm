{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/error-response.schema.json",
  "title": "Fleet v1 error-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "error": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "v",
    "error"
  ],
  "description": "Implementation extension: stable HTTP error code, including failed login responses."
}
