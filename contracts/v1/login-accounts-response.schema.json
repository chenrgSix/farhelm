{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/login-accounts-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "accounts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "login-account.schema.json"
      }
    }
  },
  "required": ["v", "accounts"]
}
