{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/tcp-mapping-create.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "enabled": {
      "type": "boolean"
    },
    "listen_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 45
    },
    "listen_port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "target_host": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "target_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "source_cidrs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  },
  "required": [
    "v",
    "name",
    "enabled",
    "listen_host",
    "listen_port",
    "target_host",
    "target_port",
    "source_cidrs"
  ]
}
