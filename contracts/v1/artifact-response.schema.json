{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/artifact-response.schema.json",
  "title": "Farhelm v1 artifact-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "sha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    }
  },
  "required": [
    "v",
    "sha256",
    "size"
  ],
  "description": "Upload response; stored stream references omit v. Upload request and download response are raw octets, not JSON."
}
