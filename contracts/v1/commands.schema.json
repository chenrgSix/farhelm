{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/commands.schema.json",
  "title": "Farhelm v1 commands",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "argv": {
      "$ref": "common.schema.json#/$defs/argv"
    },
    "cwd": {
      "$ref": "common.schema.json#/$defs/cwd"
    },
    "timeout_ms": {
      "$ref": "common.schema.json#/$defs/timeout_ms"
    },
    "max_output_bytes": {
      "$ref": "common.schema.json#/$defs/max_output_bytes"
    },
    "ttl_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    }
  },
  "required": [
    "v",
    "device_id",
    "argv",
    "cwd",
    "timeout_ms",
    "max_output_bytes",
    "ttl_seconds"
  ],
  "description": "User command request. Idempotency-Key is a required HTTP header, not a JSON field. actor_id, task_id, action, timestamps and hash are assigned by the authenticated server."
}
