{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/deployment-settings.schema.json",
  "title": "Farhelm v1 deployment-settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device_access": {
      "enum": [
        "agent-ssh",
        "ssh-only"
      ]
    },
    "web_enabled": {
      "type": "boolean"
    },
    "web_protocol": {
      "enum": [
        "http",
        "https"
      ]
    }
  },
  "required": [
    "device_access",
    "web_enabled",
    "web_protocol"
  ]
}
