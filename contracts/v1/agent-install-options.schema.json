{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/agent-install-options.schema.json",
  "title": "Farhelm v1 agent-install-options",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "server_url": {
      "type": "string",
      "maxLength": 2048
    },
    "architectures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "x86_64",
          "aarch64"
        ]
      },
      "maxItems": 2
    },
    "private_ca": {
      "type": "boolean"
    }
  },
  "required": [
    "v",
    "server_url",
    "architectures",
    "private_ca"
  ]
}
