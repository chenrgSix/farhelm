{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/health-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "check_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "healthy": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z0-9_]+$"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 30000
    }
  },
  "required": [
    "revision",
    "check_id",
    "seq",
    "healthy",
    "reason",
    "duration_ms"
  ]
}
