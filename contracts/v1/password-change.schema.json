{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/password-change.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "current_password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "new_password": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1024
    }
  },
  "required": ["v", "current_password", "new_password"]
}
