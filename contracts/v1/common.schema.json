{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/common.schema.json",
  "title": "Fleet v1 common",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\r\\n\\u0000\\uD800-\\uDFFF]+$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{42}[AEIMQUYcgkosw048]=$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{85}[AQgw]==$"
    },
    "base64": {
      "type": "string",
      "minLength": 4,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=|[A-Za-z0-9+/][AQgw]==)?$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\r\\n\\u0000\\uD800-\\uDFFF]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "argument": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "common.schema.json#/$defs/argument"
            },
            {
              "type": "string",
              "pattern": "^(?:/.*|[^/]+)$"
            }
          ]
        }
      ],
      "items": {
        "$ref": "common.schema.json#/$defs/argument"
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/[^\\u0000\\uD800-\\uDFFF]*$"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 3600000
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "terminal_status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED",
        "EXPIRED",
        "UNKNOWN"
      ]
    },
    "task_status": {
      "enum": [
        "QUEUED",
        "SENT",
        "ACCEPTED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "CANCELLED",
        "EXPIRED",
        "UNKNOWN"
      ]
    },
    "empty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      },
      "required": [
        "sha256",
        "size"
      ]
    }
  },
  "description": "Shared scalar bounds and exact structures. Limits align with the server implementation; aggregate byte limits remain runtime checks."
}
