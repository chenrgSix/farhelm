{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/connection-limits.schema.json",
  "title": "Farhelm connection limits",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "per_user": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "per_device": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "terminal_total": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "ssh_total": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "ssh_per_ip": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "updated_at": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  },
  "required": [
    "v",
    "revision",
    "per_user",
    "per_device",
    "terminal_total",
    "ssh_total",
    "ssh_per_ip",
    "updated_at"
  ]
}
