{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/health-envelope.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "health.config"
        },
        "body": {
          "$ref": "health-config.schema.json#/$defs/snapshot"
        }
      },
      "required": [
        "v",
        "type",
        "body"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "health.run"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "revision"
          ]
        }
      },
      "required": [
        "v",
        "type",
        "body"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "health.result"
        },
        "body": {
          "$ref": "health-result.schema.json"
        }
      },
      "required": [
        "v",
        "type",
        "body"
      ]
    }
  ]
}
