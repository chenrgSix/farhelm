{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/effective-authorization-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "username": {
          "type": "string",
          "maxLength": 128
        },
        "role_names": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "permissions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "access-management-response.schema.json#/properties/permissions/items/properties/id"
          }
        }
      },
      "required": ["id", "username", "role_names", "permissions"]
    },
    "accounts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "device_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string",
            "maxLength": 256
          },
          "username": {
            "type": "string",
            "maxLength": 256
          },
          "method": {
            "const": "default"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "is_default": {
            "const": true
          },
          "allowed": {
            "type": "boolean"
          },
          "reasons": {
            "type": "array",
            "maxItems": 10000,
            "items": {
              "type": "string",
              "maxLength": 512
            }
          },
          "missing": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "required": [
          "id",
          "device_id",
          "name",
          "username",
          "method",
          "revision",
          "is_default",
          "allowed",
          "reasons",
          "missing"
        ]
      }
    }
  },
  "required": ["v", "user", "accounts"]
}
