{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/network-probe-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "enabled": {
      "type": "boolean"
    },
    "interval_secs": {
      "type": "integer",
      "minimum": 5,
      "maximum": 3600
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 10000
    },
    "failure_threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "targets": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^(https?://[^\\s/@?#]+[^\\s#]*|tcp://[^\\s/@?#]+:[0-9]+/?)$",
        "description": "Runtime validation limits the original URL to 512 UTF-8 bytes and rejects whitespace/control characters."
      }
    }
  },
  "required": [
    "revision",
    "enabled",
    "interval_secs",
    "timeout_ms",
    "failure_threshold",
    "targets"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "targets": {
            "minItems": 2,
            "type": "array"
          }
        }
      }
    }
  ]
}
