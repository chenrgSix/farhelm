{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/tcp-forward-envelope.schema.json",
  "title": "Device TCP forwarding control frames",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "tcp.open"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forward_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "host": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": ["forward_id", "host", "port"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "tcp.opened"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forward_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "required": ["forward_id"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "tcp.data"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forward_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "data": {
              "allOf": [
                {
                  "$ref": "common.schema.json#/$defs/base64"
                },
                {
                  "type": "string",
                  "maxLength": 10924
                }
              ]
            }
          },
          "required": ["forward_id", "seq", "data"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "tcp.ack"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forward_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": ["forward_id", "seq"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "tcp.end"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forward_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "required": ["forward_id"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "tcp.close"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forward_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            }
          },
          "required": ["forward_id"]
        }
      },
      "required": ["v", "type", "body"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "tcp.closed"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "forward_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": ["forward_id", "reason"]
        }
      },
      "required": ["v", "type", "body"]
    }
  ]
}
