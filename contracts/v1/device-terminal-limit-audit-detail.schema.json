{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/device-terminal-limit-audit-detail.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "terminal_limit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "effective_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    }
  },
  "required": [
    "revision",
    "terminal_limit",
    "effective_limit"
  ]
}
