{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/device-terminal-limit.schema.json",
  "title": "Farhelm device terminal limit",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "global_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "effective_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "source": {
      "enum": [
        "global",
        "device"
      ]
    },
    "updated_at": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "v",
    "device_id",
    "revision",
    "limit",
    "global_limit",
    "effective_limit",
    "source",
    "updated_at"
  ],
  "oneOf": [
    {
      "properties": {
        "source": {
          "const": "global"
        },
        "limit": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "source": {
          "const": "device"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      }
    }
  ]
}
