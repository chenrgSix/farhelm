{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/api-token-update.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "devices.read",
          "terminal.connect",
          "tasks.read",
          "tasks.read_all",
          "tasks.execute",
          "recordings.read",
          "recordings.read_all",
          "audit.read",
          "audit.read_all",
          "health.manage",
          "network.manage"
        ]
      },
      "uniqueItems": true,
      "maxItems": 11,
      "minItems": 1
    },
    "device_scope": {
      "anyOf": [
        {
          "const": "*"
        },
        {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        }
      ]
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740990
    }
  },
  "required": [
    "v",
    "name",
    "permissions",
    "device_scope",
    "expires_at",
    "revision"
  ]
}
