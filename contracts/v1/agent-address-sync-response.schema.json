{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/agent-address-sync-response.schema.json",
  "title": "Farhelm v1 agent-address-sync-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "server_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https://[^\\s/@?#]+/?$"
          },
          "status": {
            "enum": [
              "pending",
              "checking",
              "saved",
              "applied",
              "failed",
              "unsupported",
              "network_managed"
            ]
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "online": {
            "type": "boolean"
          },
          "updated_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        },
        "required": [
          "device_id",
          "name",
          "revision",
          "server_url",
          "status",
          "reason",
          "online",
          "updated_at"
        ]
      }
    }
  },
  "required": ["v", "revision", "devices"]
}
