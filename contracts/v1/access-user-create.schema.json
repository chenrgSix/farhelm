{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/access-user-create.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.@-]{0,63}$"
    },
    "enabled": {
      "type": "boolean"
    },
    "role_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 32
    },
    "group_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true,
      "maxItems": 100
    },
    "device_scope": {
      "anyOf": [
        {
          "const": "*"
        },
        {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true,
          "maxItems": 1000
        }
      ]
    },
    "password": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1024
    }
  },
  "required": [
    "v",
    "username",
    "enabled",
    "role_ids",
    "group_ids",
    "device_scope",
    "password"
  ]
}
