{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/access-authorization.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "account_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "subject_type": {
      "enum": ["user", "group", "role", "device_scope"]
    },
    "subject_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject_name": {
      "type": "string",
      "maxLength": 256
    },
    "legacy_scope": {
      "type": "boolean"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "id",
    "device_id",
    "account_id",
    "subject_type",
    "subject_id",
    "subject_name",
    "legacy_scope",
    "revision"
  ]
}
