{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/access-role-create.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 0,
      "maxLength": 500
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "devices.read",
          "terminal.connect",
          "terminal.sudo",
          "tasks.read",
          "tasks.read_all",
          "tasks.execute",
          "recordings.read",
          "recordings.read_all",
          "audit.read",
          "audit.read_all",
          "health.manage",
          "network.manage"
        ]
      },
      "uniqueItems": true,
      "maxItems": 12
    }
  },
  "required": ["v", "name", "description", "permissions"]
}
