{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/contracts/v1/auth-response.schema.json",
  "title": "Fleet v1 auth-response",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "v": {
      "const": 1
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "access_token": {
      "$ref": "common.schema.json#/$defs/token"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "required": [
    "v",
    "device_id",
    "access_token",
    "expires_at"
  ]
}
